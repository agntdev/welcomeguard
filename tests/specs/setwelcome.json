[
  {
    "name": "/setwelcome requires admin permissions",
    "steps": [
      {
        "send": { "text": "/setwelcome" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can change settings."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "/setwelcome with text requires admin permissions",
    "steps": [
      {
        "send": { "text": "/setwelcome Hello new members!" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can change settings."
            }
          }
        ]
      }
    ]
  }
]
