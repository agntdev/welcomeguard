[
  {
    "name": "/mute requires admin permissions",
    "steps": [
      {
        "send": { "text": "/mute" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can use this command."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "/mute shows usage without target",
    "steps": [
      {
        "send": { "text": "/mute test 10m" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can use this command."
            }
          }
        ]
      }
    ]
  }
]
