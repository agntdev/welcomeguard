[
  {
    "name": "/setthresholds requires admin permissions",
    "steps": [
      {
        "send": { "text": "/setthresholds" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can change settings."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "/setthresholds with values requires admin permissions",
    "steps": [
      {
        "send": { "text": "/setthresholds 2 4 5" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Only admins can change settings."
            }
          }
        ]
      }
    ]
  }
]
